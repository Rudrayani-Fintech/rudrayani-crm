PORT=4000
NODE_ENV=development

DATABASE_URL=postgres://rudrayani:rudrayani_dev_pass@localhost:5432/rudrayani_crm

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h

# SMS/OTP provider (fill in when you pick one, e.g. MSG91, Twilio)
SMS_PROVIDER_API_KEY=

# Auth policies (defaults shown; all optional)
REFRESH_TOKEN_TTL_DAYS=30
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
OTP_EXPIRY_MINUTES=10
OTP_MAX_VERIFY_ATTEMPTS=5

# Local file storage root (uploads: import files, payment proofs, signatures)
UPLOAD_DIR=uploads

# Comma-separated allowed origins for the web portal. Required in production
# -- unset means every origin is allowed. e.g.:
# CORS_ORIGIN=https://app.rudrayanifintechs.com
CORS_ORIGIN=

# Returns the password-reset OTP in the API response so you can test the
# reset flow locally without a real SMS provider. Leave unset/false in
# every real deployment.
ALLOW_OTP_ECHO=true
